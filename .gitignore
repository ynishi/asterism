# Rust build artifact
target
.ryo

# Local scratch: task workspace, git worktrees
workspace
.worktrees

# What every contributor shares stays committed: .claude/CLAUDE.md, which
# points at the documents in this repository, and settings.json. Everything a
# plugin can carry is installed rather than cloned — agents, skills, commands
# and hooks come from the marketplace in ./plugins, so a checkout is not how
# they reach a machine and a local edit to one is not this repository's to
# review. Per-person local state stays out for the same reason.
.claude/settings.local.json
.claude/CLAUDE.local.md
.claude/agents/
.claude/skills/
.claude/commands/
.claude/hooks/
.claude/plugins/

