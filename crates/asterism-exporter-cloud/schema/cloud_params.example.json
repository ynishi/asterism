{
  "endpoint": "https://queue.fal.run",

  "auth": {
    "secret_ref": "FAL_KEY",
    "header": "authorization",
    "value_template": "Key {{secret}}"
  },

  "submit": {
    "method": "POST",
    "path": "/fal-ai/flux/dev",
    "body_template": {
      "prompt": "{{params.extras.prompt}}",
      "image_size": "landscape_4_3",
      "num_images": 1
    },
    "handle_from": "$.request_id"
  },

  "poll": {
    "method": "GET",
    "path": "/fal-ai/flux/dev/requests/{{handle}}/status",
    "done_when": { "path": "$.status", "equals": "COMPLETED" },
    "failed_when": {
      "path": "$.status",
      "equals": "ERROR",
      "message_path": "$.error.message"
    },
    "progress_message_path": "$.queue_position"
  },

  "harvest": {
    "method": "GET",
    "path": "/fal-ai/flux/dev/requests/{{handle}}",
    "items_path": "$.images[*]",
    "map": {
      "modality": "image",
      "source_url": "{{item.url}}",
      "labels_static": ["batch:{{dispatch_id}}", "platform:fal.ai"]
    }
  },

  "fetch": {
    "authenticated": false
  },

  "deadline_seconds": 86400,

  "extras": {
    "prompt": "photo studio portrait"
  }
}
