{
  "endpoint": "http://127.0.0.1:8188",
  "prompt": "same subject, golden hour",
  "count": 4,
  "workflow": {
    "4": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": { "ckpt_name": "model.safetensors" }
    },
    "10": {
      "class_type": "LoadImage",
      "inputs": { "image": "<set from input_slot after upload>" }
    },
    "11": {
      "class_type": "VAEEncode",
      "inputs": { "pixels": ["10", 0], "vae": ["4", 2] }
    },
    "12": {
      "class_type": "RepeatLatentBatch",
      "inputs": { "samples": ["11", 0], "amount": "{{params.count}}" }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "{{params.prompt}}", "clip": ["4", 1] }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "{{params.negative?}}", "clip": ["4", 1] }
    },
    "3": {
      "class_type": "KSampler",
      "inputs": {
        "seed": "{{params.seed?}}",
        "steps": 30,
        "cfg": 6.5,
        "sampler_name": "dpmpp_2m",
        "scheduler": "karras",
        "denoise": 0.6,
        "model": ["4", 0],
        "positive": ["6", 0],
        "negative": ["7", 0],
        "latent_image": ["12", 0]
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": { "samples": ["3", 0], "vae": ["4", 2] }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": { "filename_prefix": "asterism/{{dispatch_id}}", "images": ["8", 0] }
    }
  },
  "input_slot": { "10": 0 },
  "poll_interval_ms": 2000
}
