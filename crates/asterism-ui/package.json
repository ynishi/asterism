{
  "name": "asterism-ui-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run check:app && npm run check:e2e",
    "check:app": "svelte-check --tsconfig ./tsconfig.json",
    "check:e2e": "tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "tauri": "tauri",
    "app:dev": "ASTERISM_PROFILE=dev ASTERISM_HOME=../../workspace/runtime/dev tauri dev --config src-tauri/tauri.dev.conf.json",
    "app:bench": "ASTERISM_PROFILE=bench ASTERISM_HOME=$HOME/.asterism/profiles/bench tauri dev --config src-tauri/tauri.dev.conf.json",
    "app:dogfood:build": "tauri build --config src-tauri/tauri.bundle.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-log": "^2.0.0",
    "dompurify": "^3.4.12",
    "marked": "^18.0.6",
    "virtua": "^0.49.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.3",
    "@tsconfig/svelte": "^5.0.0",
    "@wdio/cli": "^9.30.0",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/tauri-plugin": "^1.1.0",
    "@wdio/tauri-service": "^1.1.0",
    "happy-dom": "^20.11.1",
    "prettier": "^3.9.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.7.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10",
    "webdriverio": "^9.30.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
