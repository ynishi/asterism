{
  "endpoint": "https://backend.example.com",
  "submit": {
    "method": "POST",
    "path": "/jobs",
    "body_template": {
      "workflow": "img2img",
      "input_url": "{{input[0].source_locator}}",
      "prompt": "{{params.extras.prompt}}",
      "client_id": "{{dispatch_id}}"
    },
    "handle_from": "$.job_id"
  },
  "poll": {
    "method": "GET",
    "path": "/jobs/{{handle}}",
    "done_when": { "path": "$.status", "equals": "succeeded" },
    "failed_when": {
      "path": "$.status",
      "equals": "failed",
      "message_path": "$.error"
    },
    "progress_message_path": "$.progress_message"
  },
  "harvest": {
    "method": "GET",
    "path": "/jobs/{{handle}}/results",
    "items_path": "$.outputs[*]",
    "map": {
      "modality": "image",
      "source_url": "{{item.url}}",
      "cover_hint": "{{item.caption?}}",
      "labels_static": ["batch:{{dispatch_id}}"]
    }
  },

  "auth": {
    "secret_ref": "BACKEND_KEY",
    "header": "authorization",
    "value_template": "Bearer {{secret}}"
  },
  "fetch": {
    "authenticated": false
  },
  "deadline_seconds": 86400,

  "extras": {
    "prompt": "photo studio portrait"
  }
}
